function requiredFilled(){ return true; }

function updateSummary(){
  const summary = document.getElementById('summary');
  const sendBtn = document.getElementById('sendBtn');
  const items = [];

  Object.entries(window.cart).forEach(([product, arr])=>{
    arr.forEach(({flavour, qty})=> items.push(product + ' — ' + flavour + ' x ' + qty));
  });

  if(items.length===0){
    summary.textContent='No items selected yet.';
  } else {
    summary.textContent = items.length + ' item(s) ready to send.';
  }

  // Safely handle (now-removed) header inputs
  const nameEl = document.getElementById('custName');
  const numEl  = document.getElementById('custNumber');
  if (nameEl) nameEl.classList.toggle('ok', !!nameEl.value.trim());
  if (numEl)  numEl.classList.toggle('ok',  !!numEl.value.trim());

  // Enable based on cart only (fields collected in modal)
  const enable = items.length > 0;
  sendBtn.disabled = !enable;
  sendBtn.classList.toggle('enabled', enable);
}




// ================= MESSAGE =================
function buildMessage(){
  const name = document.getElementById('custName').value.trim();
  const num  = document.getElementById('custNumber').value.trim();
  const extra= document.getElementById('notes').value.trim();
  const lines = [];
  lines.push('Name: ' + name);
  lines.push('Customer Number: ' + num);
  lines.push('Order:');
  Object.entries(window.cart).forEach(([product, arr])=>{
    lines.push('- ' + product);
    arr.forEach(({flavour, qty})=> lines.push('  - ' + flavour + ' x' + qty));
  });
  if(extra) lines.push('Notes: ' + extra);
  return lines.join('\n');
}

function normalizePhone(raw){
  const digits = (raw||'').replace(/\D/g,'');
  if(digits.startsWith('00')) return digits.slice(2);
  if(digits.startsWith('0'))  return '44' + digits.slice(1);
  return digits;
}

function setFallbackLinks(text, phone){
  const waMe = 'https://wa.me/' + phone + '?text=' + encodeURIComponent(text);
  const api  = 'https://api.whatsapp.com/send?phone=' + phone + '&text=' + encodeURIComponent(text);
  document.getElementById('waMeLink').href = waMe;
  document.getElementById('apiLink').href  = api;
  document.getElementById('rawMessage').value = text;
  document.getElementById('fallbackBox').style.display = 'block';
}

function safeOpen(url){
  const a = document.createElement('a');
  a.href = url; a.target = '_blank'; a.rel = 'noopener';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
}

