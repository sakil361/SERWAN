  .modal-header{ display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
  .modal-header h3{ margin:0; font-size:20px; }

  .modal-actions{ display:flex; gap:8px; margin-top:12px; }

  /* Buttons inside dialog */
  .btn-ghost{
    background:#162232;
    border:1px solid #263448;
    color:#cfe0f5;
    border-radius:10px;
    padding:10px 12px;
    cursor:pointer;
  }
  #confirmSend{
    background:var(--accent);
    color:#0b0f14;
    border:none;
    border-radius:10px;
    padding:12px 14px;
    font-weight:700;
    cursor:pointer;
  }

  /* Inputs in dialog reuse your global styles, but ensure full width on narrow screens */
  #checkoutDialog input, #checkoutDialog textarea{ width:100%; }
</style>

<dialog id="checkoutDialog">
  <div class="modal-header">
    <h3>Enter details to send order</h3>
    <button id="closeDialog" class="btn-ghost" formmethod="dialog">✕</button>
  </div>

  <div class="row">
    <input id="custNameModal" type="text" placeholder="Customer name (required)" required />
    <input id="custNumberModal" type="tel" inputmode="tel" placeholder="Customer Mobile No. (required)" required />
  </div>
  <div class="row">
    <textarea id="notesModal" placeholder="Additional info (optional)"></textarea>
  </div>

  <div class="modal-actions">
    <button id="cancelDialog" class="btn-ghost" formmethod="dialog">Cancel</button>
    <button id="confirmSend" class="btn enabled">Send Order via WhatsApp</button>
  </div>
</dialog>

