      // ----- Nicsalts brands -----
      } else if (category === 'Nicsalts' && (
        name === 'ELUX' ||
        name === 'FIREROSE' ||
        name === 'CRYSTAL CLEAR' ||
        name === 'ELFLIQ' ||
        name === 'OX PASSION' ||
        name === 'HAYATI' ||
        name === 'BAR JUICE'
        
      )) {
        const brand   = document.createElement('div');
        brand.className = 'brand';

        const head = document.createElement('div');
        head.className = 'head';

        const h2 = document.createElement('h2');
        h2.textContent = name;

        const toggle = document.createElement('button');
        toggle.textContent       = 'Show products';
        toggle.dataset.showLabel = 'Show products';
        toggle.dataset.hideLabel = 'Hide products';

        head.append(h2, toggle);

        const content = document.createElement('div');
        content.className = 'brand-content';
        renderGroup(content, val, category);

        head.addEventListener('click', () => {
          const isOpenNow = content.style.display === 'block';
          const willOpen  = !isOpenNow;

          document.querySelectorAll('.brand-content').forEach(el => el.style.display = 'none');
          document.querySelectorAll('.brand').forEach(card => card.classList.remove('open'));
          document.querySelectorAll('.brand .head button').forEach(b => {
            const show = b.dataset.showLabel || b.textContent;
            b.textContent = show;
          });

          if (willOpen) {
            content.style.display = 'block';
            toggle.textContent = toggle.dataset.hideLabel || 'Hide products';
            brand.classList.add('open');
          } else {
            content.style.display = 'none';
            toggle.textContent = toggle.dataset.showLabel || 'Show products';
            brand.classList.remove('open');
          }
        });

        brand.append(head, content);
        container.appendChild(brand);

      // ----- DRINKS: click DRINKS first, then brand dropdowns -----
      } else if (category === 'Misc Items' && name === 'DRINKS') {

        // Main DRINKS dropdown
        const drinks = document.createElement('div');
        drinks.className = 'brand drinks-main';

        const drinksHead = document.createElement('div');
        drinksHead.className = 'head';

        const drinksHeadLeft = document.createElement('div');
        drinksHeadLeft.className = 'head-left';

        const drinksHeadRight = document.createElement('div');
        drinksHeadRight.className = 'head-right';

        const drinksH2 = document.createElement('h2');
        drinksH2.textContent = 'DRINKS';
        drinksH2.style.margin = '0';
        drinksH2.style.fontSize = '18px';

        const drinksToggle = document.createElement('button');
        drinksToggle.className = 'toggle-btn';
        drinksToggle.textContent = 'Show brands';
        drinksToggle.dataset.showLabel = 'Show brands';
        drinksToggle.dataset.hideLabel = 'Hide brands';

        drinksHeadLeft.appendChild(drinksH2);
        drinksHeadRight.appendChild(drinksToggle);
        drinksHead.append(drinksHeadLeft, drinksHeadRight);

        const drinksContent = document.createElement('div');
        drinksContent.className = 'brand-content drinks-brands';

        // Create each brand INSIDE the DRINKS dropdown
        Object.entries(val).forEach(([brandName, items]) => {

          const brand = document.createElement('div');
          brand.className = 'brand drink-brand';

          const head = document.createElement('div');
          head.className = 'head';

          const headLeft = document.createElement('div');
          headLeft.className = 'head-left';

          const headRight = document.createElement('div');
          headRight.className = 'head-right';

          const h2 = document.createElement('h2');
          h2.textContent = brandName;
          h2.style.margin = '0';
          h2.style.fontSize = '18px';

          const toggle = document.createElement('button');
          toggle.className = 'toggle-btn';
          toggle.textContent = 'Show products';
          toggle.dataset.showLabel = 'Show products';
          toggle.dataset.hideLabel = 'Hide products';

          headLeft.appendChild(h2);
          headRight.appendChild(toggle);
          head.append(headLeft, headRight);

          const content = document.createElement('div');
          content.className = 'brand-content drink-items';

          // Product/flavour rows shown directly when brand opens
          items.forEach(item => {

            const row = document.createElement('div');
            row.className = 'chip';

            const label = document.createElement('div');
            label.textContent = item;
            label.style.flex = '1';

            const qtyWrap = document.createElement('div');
            qtyWrap.className = 'qty';

            const minus = document.createElement('button');
            minus.textContent = '-';

            const qty = document.createElement('input');
            qty.type = 'number';
            qty.min = '0';
            qty.value = '0';

            const plus = document.createElement('button');
            plus.textContent = '+';

            const isOOS =
              (OOS[brandName] && OOS[brandName].has(item)) ||
              (OOS['DRINKS'] && OOS['DRINKS'].has(item));

            if (isOOS) {
              row.classList.add('oos');
              minus.disabled = true;
              plus.disabled = true;
              qty.disabled = true;
            }

            function setDrinkQty(v) {
              if (isOOS) return;

              const n = Math.max(0, parseInt(v || 0, 10));
              qty.value = n;
              row.classList.toggle('selected', n > 0);

              if (!window.cart[brandName]) {
                window.cart[brandName] = [];
              }

              const i = window.cart[brandName]
                .findIndex(x => x.flavour === item);

              if (n === 0) {
                if (i > -1) {
                  window.cart[brandName].splice(i, 1);
                }
              } else {
                if (i > -1) {
                  window.cart[brandName][i].qty = n;
                } else {
                  window.cart[brandName].push({
                    flavour: item,
                    qty: n
                  });
                }
              }

              if (
                window.cart[brandName] &&
                window.cart[brandName].length === 0
              ) {
                delete window.cart[brandName];
              }

              updateSummary();
            }

            minus.addEventListener('click', e => {
              e.stopPropagation();
              setDrinkQty(
                parseInt(qty.value || 0, 10) - 1
              );
            });

            plus.addEventListener('click', e => {
              e.stopPropagation();
              setDrinkQty(
                parseInt(qty.value || 0, 10) + 1
              );
            });

            qty.addEventListener('click', e => {
              e.stopPropagation();
            });

            qty.addEventListener('input', () => {
              setDrinkQty(qty.value);
            });

            qtyWrap.append(minus, qty, plus);

            const rightWrap = document.createElement('div');
            rightWrap.className = 'right-wrap';

            const optionPrice = PRICE[item];

            if (optionPrice != null) {
              const optPrice = document.createElement('span');
              optPrice.className = 'opt-price';
              optPrice.textContent = money(optionPrice);
              rightWrap.appendChild(optPrice);
            }

            rightWrap.appendChild(qtyWrap);
            row.append(label, rightWrap);
            content.appendChild(row);
          });

          // Brand click: open that brand's products
          head.addEventListener('click', e => {
            e.stopPropagation();

            const willOpen =
              content.style.display !== 'block';

            // Close the other drink brands only
            drinksContent
              .querySelectorAll(':scope > .drink-brand')
              .forEach(otherBrand => {

                if (otherBrand === brand) return;

                const otherContent =
                  otherBrand.querySelector(
                    ':scope > .drink-items'
                  );

                const otherToggle =
                  otherBrand.querySelector(
                    ':scope > .head .toggle-btn'
                  );

                if (otherContent) {
                  otherContent.style.display = 'none';
                }

                otherBrand.classList.remove('open');

                if (otherToggle) {
                  otherToggle.textContent =
                    otherToggle.dataset.showLabel ||
                    'Show products';
                }
              });

            if (willOpen) {
              content.style.display = 'block';
              toggle.textContent = 'Hide products';
              brand.classList.add('open');
            } else {
              content.style.display = 'none';
              toggle.textContent = 'Show products';
              brand.classList.remove('open');
            }
          });

          brand.append(head, content);
          drinksContent.appendChild(brand);
        });

        // Main DRINKS click: show/hide all brands
        drinksHead.addEventListener('click', () => {

          const willOpen =
            drinksContent.style.display !== 'block';

          if (willOpen) {
            drinksContent.style.display = 'block';
            drinksToggle.textContent = 'Hide brands';
            drinks.classList.add('open');
          } else {
            drinksContent.style.display = 'none';
            drinksToggle.textContent = 'Show brands';
            drinks.classList.remove('open');

            // Reset brand dropdowns when DRINKS closes
            drinksContent
              .querySelectorAll('.drink-items')
              .forEach(el => {
                el.style.display = 'none';
              });

            drinksContent
              .querySelectorAll('.drink-brand')
              .forEach(el => {
                el.classList.remove('open');
              });

            drinksContent
              .querySelectorAll(
                '.drink-brand > .head .toggle-btn'
              )
              .forEach(btn => {
                btn.textContent =
                  btn.dataset.showLabel ||
                  'Show products';
              });
          }
        });

        drinks.append(drinksHead, drinksContent);
        container.appendChild(drinks);

      // ----- Other nested objects: simple subcategory then recurse -----
      } else {
        const sub = document.createElement('div');
        sub.className = 'subcat';
        sub.textContent = name;
        container.appendChild(sub);
        renderGroup(container, val, category);
      }
    }
  });
}


