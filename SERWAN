<style>

  .product.open,
.brand.open{
  background:#151e30;          /* darker card when open */
  border-color:#2f81ff;        /* subtle blue border */
  box-shadow:0 0 0 1px #2f81ff44;
}

  .product.open,
.brand.open{
  border-color: #26d07c;       /* accent */
  box-shadow: 0 0 0 1px #26d07c55;
  background:#151d29;
}


/* Product image size inside Smoking chips */
.chip-img{
  width:90px;
  height:90px;
  object-fit:cover;
  border-radius:8px;
  margin-right:10px;
  flex-shrink:0;
}
  .main-title {
  text-align: center;
  width: 100%;
  font-size: 32px;
  font-weight: 900;
  letter-spacing: 1px;
  color: #26d07c;
  text-shadow: 0 0 10px #26d07c55;
  margin-bottom: 6px;
}

.support-line {
  text-align: center;
  font-size: 14px;
  color: #9fb0c3;
  margin-top: 2px;
}

.wa-number {
  color: #26d07c;
  font-weight: 700;
}


.cat {
  text-align: center;
  font-size: 30px;
  font-weight: 900;
  margin: 32px 0 14px;
  padding: 10px 0;
  color: #26d07c;
  text-shadow: 0 0 10px #26d07c55;
  background: #0c161f;
  border-radius: 14px;
  border: 2px solid #26d07c44;
}


.price-tag{
  font-size: 16px;
  font-weight: 600;
  color: #0b0f14;
  background: #26d07c;
  padding: 4px 10px;
  border-radius: 999px;
  box-shadow: 0 0 6px #26d07c88;
  margin-left: auto;
  margin-right: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}



  :root { --bg:#0b0f14; --card:#121821; --muted:#9fb0c3; --accent:#26d07c; }
  *{box-sizing:border-box}
 
  header{position:sticky;top:0;background:#0b0f14;z-index:20;padding:18px 16px;border-bottom:1px solid #1f2732}
  .title{font-size:26px;font-weight:700}
  input,textarea{background:#0f1520;border:2px solid red;border-radius:10px;color:#e9f0f6;padding:12px 14px;width:100%}
  .ok{border-color:limegreen!important}
  .row{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
  .container{max-width:980px;margin:0 auto;padding:16px}
  .cat{margin:18px 0 8px;font-weight:700;opacity:.95}
  .product,.brand{background:var(--card);border:1px solid #1f2732;border-radius:14px;margin:12px 0;padding:14px}
  .head{
  display:flex;
  justify-content:space-between;
  cursor:pointer;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
}
  .flavours,.brand-content{display:none;padding-top:10px;border-top:1px dashed #2a3545;margin-top:10px}
  .chip{display:flex;justify-content:space-between;align-items:center;background:#0f1520;border:1px solid #243244;padding:8px;border-radius:10px;margin:6px 0;position:relative}
 .chip{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
  background:#0f1520;
  border:1px solid #243244;
  padding:8px;
  border-radius:10px;
  margin:6px 0;
  position:relative;
}

.chip > div:first-child{
  min-width:0;
}

.qty{
  display:flex;
  gap:6px;
  align-items:center;
  flex-shrink:0;
}

.qty button{
  min-width:32px;
  height:32px;
}

.qty input{
  width:50px;
  min-width:50px;
  text-align:center;
}

.right-wrap{
  margin-left:auto;
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
  justify-content:flex-end;
}

/* Sticky bottom send bar */
.sticky-send{
  position:fixed;
  left:0;
  right:0;
  bottom:0;
  z-index:9999;
  background:#0b0f14;
  border-top:1px solid #1f2732;
  padding:12px 16px;
  box-shadow:0 -6px 18px rgba(0,0,0,.35);
}

/* Main send button */
.btn{
  background:#26d07c;
  border:none;
  border-radius:12px;
  padding:14px 16px;
  font-weight:800;
  width:100%;
  cursor:pointer;
  opacity:.6;
  color:#0b0f14;
  font-size:16px;
  box-shadow:0 6px 16px rgba(38,208,124,.25);
}

.btn.enabled{
  opacity:1;
}

/* Stop page content hiding behind sticky bar */
body{
  margin:0;
  padding-bottom:95px;
  font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,Helvetica,Arial,sans-serif;
  background:var(--bg);
  color:#e9f0f6;
}

  .fallback{display:none;background:#111a28;border:1px solid #24364a;border-radius:10px;padding:12px 14px;margin:12px 16px}
  .fallback a{color:#7cdfff}
  .fallback textarea{background:#0f1520;border:1px solid #203040;color:#cfe0f5;border-radius:8px;padding:8px;width:100%}
  
  .subcat{margin:6px 0 4px;color:#b7c7da;font-weight:600}
  .brand .head h2{margin:0;font-size:18px}
  .brand .head button,.product .head button{padding:6px 10px;border-radius:10px;border:1px solid #263445;background:#172131;color:#cfe0f5}

  /* Out-of-stock styling */
  .oos{
    opacity:.45;
    filter:grayscale(1);
  }
  .oos::after{
    content:"Out of stock";
    position:absolute;
    right:10px;
    top:50%;
    transform:translateY(-50%);
    font-size:12px;
    color:#9fb0c3;
    background:#1a2535;
    border:1px solid #2a3648;
    padding:2px 6px;
    border-radius:999px;
  }
  .oos .qty button,
  .oos .qty input{
    pointer-events:none;
    opacity:.6;
  }
.image-btn{
  background:#162232;
  border:1px solid #263448;
  color:#cfe0f5;
  border-radius:7px;
  padding:5px 8px;
  cursor:pointer;
  font-size:12px;
  line-height:1.1;
  white-space:nowrap;
  flex-shrink:0;
}
  @media (max-width: 640px){
  .product .head,
  .brand .head{
    gap:6px;
    flex-wrap:wrap;
  }

  .price-tag,
  .image-btn,
  .product .head .toggle-btn,
  .brand .head .toggle-btn{
    font-size:11px;
    padding:4px 7px;
  }

  .product .head h2,
  .brand .head h2{
    font-size:15px !important;
    min-width:100%;
  }
}

.image-btn:hover{
  border-color:#26d07c;
  color:#26d07c;
}

.img-modal{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.75);
  z-index:9999;
  align-items:center;
  justify-content:center;
  padding:20px;
}

.img-modal.open{
  display:flex;
}

.img-modal-box{
  background:#121821;
  border:1px solid #263448;
  border-radius:16px;
  padding:16px;
  max-width:90vw;
  max-height:90vh;
  width:700px;
  box-shadow:0 12px 30px rgba(0,0,0,.45);
}

.img-modal-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  margin-bottom:12px;
}

.img-modal-title{
  font-size:18px;
  font-weight:700;
  color:#e9f0f6;
}

.img-close{
  background:#162232;
  border:1px solid #263448;
  color:#cfe0f5;
  border-radius:10px;
  padding:8px 12px;
  cursor:pointer;
}

#modalImage{
  width:100%;
  max-height:70vh;
  object-fit:contain;
  border-radius:12px;
  background:#0f1520;
}

  @media (max-width: 768px){
  .container{
    padding:12px;
  }

  .main-title{
    font-size:24px;
    line-height:1.2;
  }

  .support-line{
    font-size:12px;
  }

  .cat{
    font-size:22px;
    padding:8px 10px;
    margin:22px 0 10px;
  }

  .product,
  .brand{
    padding:10px;
    border-radius:12px;
  }

  .head{
    gap:8px;
  }

  .head-left,
  .head-right{
    width:100%;
  }

  .head-right{
    justify-content:flex-start;
  }

  .head-left h2,
  .brand .head h2{
    font-size:16px !important;
    line-height:1.25;
  }

  .price-tag,
  .opt-price,
  .image-btn,
  .toggle-btn{
    font-size:11px;
    padding:5px 7px;
  }

  .chip{
    align-items:flex-start;
  }

  .chip-img{
    width:72px;
    height:72px;
    margin-right:0;
  }

  .right-wrap{
    width:100%;
    margin-left:0;
    justify-content:flex-start;
  }

  .qty button{
    min-width:30px;
    height:30px;
    padding:0 8px;
  }

  .qty input{
    width:46px;
    min-width:46px;
    padding:8px 6px;
  }

  .sticky-send{
    padding:10px 12px;
  }

  .btn{
    padding:12px;
    font-size:15px;
  }

  #summary{
    font-size:12px;
  }

  .img-modal{
    padding:10px;
  }

  .img-modal-box{
    width:100%;
    max-width:100%;
    padding:12px;
    border-radius:12px;
  }

  .img-modal-title{
    font-size:15px;
  }

  #modalImage{
    max-height:60vh;
  }

  dialog{
    width:100%;
    max-width:100%;
    margin:0;
    border-radius:14px;
    padding:12px;
  }

  .modal-actions{
    flex-direction:column;
  }

  .modal-actions button{
    width:100%;
  }
}

  /* ===== MOBILE FRIENDLY FIXES ===== */

.head-left{
  flex:1;
  min-width:0;
}

.head-right{
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
  justify-content:flex-end;
}

.opt-price{
  font-size:14px;
  font-weight:700;
  color:#0b0f14;
  background:#26d07c;
  padding:4px 9px;
  border-radius:999px;
