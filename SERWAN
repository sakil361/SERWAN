    height:36px;
    padding:6px;
    font-size:15px;
  }

  .sticky-send{
    padding:10px;
  }

  .btn{
    padding:13px;
    font-size:15px;
  }

  #summary{
    font-size:12px;
    margin-top:5px;
  }

  dialog{
    width:calc(100vw - 20px);
    max-width:calc(100vw - 20px);
  }

  .modal-actions{
    flex-direction:column;
  }

  .modal-actions button{
    width:100%;
  }

  .img-modal-box{
    width:100%;
    max-width:100%;
  }

  #modalImage{
    max-height:65vh;
  }
}
